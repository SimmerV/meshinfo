# syntax=docker/dockerfile:1
# PostgreSQL 18.6 + Citus Columnar 14.1.0. The official PostgreSQL manifest
# below includes linux/amd64 and linux/arm64. No AVX2/native CPU flags are used.
# See POSTGRES.md for provenance, architecture validation and upgrade policy.
FROM postgres:18.6@sha256:edb0c08dc33befd0262ab3b5cf1c4f3f8cfd8b09e88c05b45adee29d6761ddb6 AS postgres-base

# Both architectures use the same pinned upstream source. The shared configured
# stage also supplies the unpatched baseline for native plan/cost parity tests.
# Upstream columnar/install-columnar build only the standalone AM and generated
# SQL, without distributed Citus. Build tools remain outside the runtime images.
FROM postgres-base AS configured-source
ARG TARGETARCH
ARG COLUMNAR_BUILD_JOBS=1
ADD --checksum=sha256:e174ed00efba74aaf5a9da87f770f6a7e11274066cce8449d804bc6b17df6ff8 \
    https://codeload.github.com/citusdata/citus/tar.gz/refs/tags/v14.1.0 \
    /tmp/citus.tar.gz
RUN case "$TARGETARCH" in amd64|arm64) ;; *) exit 1 ;; esac \
    && case "$COLUMNAR_BUILD_JOBS" in 1|2) ;; *) exit 1 ;; esac \
    && apt-get update \
    && apt-get install -y --no-install-recommends \
       build-essential bison flex patch libssl-dev liblz4-dev libzstd-dev \
       "postgresql-server-dev-18=${PG_VERSION}" \
    && mkdir -p /src /out \
    && tar -xzf /tmp/citus.tar.gz --strip-components=1 -C /src \
    && cd /src \
    && PG_CONFIG=/usr/lib/postgresql/18/bin/pg_config ./configure --without-libcurl

FROM configured-source AS build-unpatched
RUN cd /src \
    && make -j"$COLUMNAR_BUILD_JOBS" with_llvm=no columnar \
    && make with_llvm=no DESTDIR=/out install-columnar

# Compile the original first, then rebuild only files changed by the patch.
# --target unpatched remains independent of the patch file and its build.
FROM build-unpatched AS build-patched
COPY patches/citus-14.1.0-planner-costing.patch /tmp/planner-costing.patch
RUN echo 'aed027459fac59a1333ace33d181c3e323bf5917293bfeded1b023fc292ea6b9  /tmp/planner-costing.patch' | sha256sum --check --strict \
    && cd /src \
    && patch --batch --forward --fuzz=0 -p1 < /tmp/planner-costing.patch \
    && test -f src/backend/columnar/columnar_customscan.o \
    && rm -f src/backend/columnar/columnar_customscan.o src/backend/columnar/columnar_customscan.bc \
    && make -j"$COLUMNAR_BUILD_JOBS" with_llvm=no columnar \
    && make with_llvm=no DESTDIR=/out install-columnar \
    && mkdir -p /out/usr/share/meshinfo-columnar \
    && cp /tmp/planner-costing.patch /out/usr/share/meshinfo-columnar/planner-costing.patch \
    && cd /out/usr/share/meshinfo-columnar \
    && sha256sum planner-costing.patch > planner-costing.patch.sha256

FROM postgres-base AS runtime-base
RUN apt-get update \
    && apt-get install -y --no-install-recommends liblz4-1 libzstd1 \
    && rm -rf /var/lib/apt/lists/*
RUN printf "\nshared_preload_libraries='citus_columnar'\n" >> /usr/share/postgresql/postgresql.conf.sample
LABEL org.opencontainers.image.title="MeshInfo PostgreSQL with Citus Columnar" \
      org.opencontainers.image.version="18.6-citus14.1.0" \
      org.opencontainers.image.source="https://github.com/citusdata/citus/tree/v14.1.0" \
      io.meshinfo.columnar.source-sha256="e174ed00efba74aaf5a9da87f770f6a7e11274066cce8449d804bc6b17df6ff8"
CMD ["postgres", "-c", "shared_preload_libraries=citus_columnar"]

FROM runtime-base AS unpatched
COPY --from=build-unpatched /out/usr/ /usr/
LABEL io.meshinfo.columnar.planner-patch="none"

FROM runtime-base AS final
COPY --from=build-patched /out/usr/ /usr/
LABEL io.meshinfo.columnar.planner-patch="planner-costing-v1" \
      io.meshinfo.columnar.patch-sha256="aed027459fac59a1333ace33d181c3e323bf5917293bfeded1b023fc292ea6b9"
