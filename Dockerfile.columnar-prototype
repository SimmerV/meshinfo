# Isolated measurement image only. This does not change the application stack.
# Reuse the PostgreSQL 18.6 image already tested by this checkout; pin the
# official Citus Debian package by SHA-256 rather than running a repo installer.
FROM postgres:18@sha256:edb0c08dc33befd0262ab3b5cf1c4f3f8cfd8b09e88c05b45adee29d6761ddb6

ADD --checksum=sha256:1e78be38f6c145bac49d622d71def8f1b9a3826d98dffe946e9aed3e0cac1b09 \
    https://packagecloud.io/citusdata/community/debian/pool/trixie/main/p/citus/postgresql-18-citus-14.1_14.1.0.citus-1_amd64.deb \
    /tmp/citus.deb
RUN apt-get update \
    && apt-get install -y --no-install-recommends /tmp/citus.deb \
    && rm -f /tmp/citus.deb \
    && rm -rf /var/lib/apt/lists/*

CMD ["postgres", "-c", "shared_preload_libraries=citus_columnar"]
